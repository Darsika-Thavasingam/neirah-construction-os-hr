generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  RESIGNED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HALF_DAY
  HOLIDAY
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveTypeStatus {
  ACTIVE
  INACTIVE
}

enum AssignmentStatus {
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum SalaryStatus {
  ACTIVE
  INACTIVE
}

model Department {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  name        String
  code        String
  description String?
  status      RecordStatus @default(ACTIVE)

  employees Employee[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, name])
  @@map("departments")
}

model Designation {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  name        String
  code        String
  description String?
  status      RecordStatus @default(ACTIVE)

  employees Employee[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, name])
  @@map("designations")
}

model Employee {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  departmentId  String? @map("department_id") @db.Uuid
  designationId String? @map("designation_id") @db.Uuid

  employeeNumber   String           @map("employee_number")
  firstName        String           @map("first_name")
  lastName         String           @map("last_name")
  email            String?
  phone            String?
  nicOrId          String?          @map("nic_or_id")
  dateOfBirth      DateTime?        @map("date_of_birth") @db.Date
  gender           Gender?
  address          String?
  employmentType   EmploymentType   @map("employment_type")
  joiningDate      DateTime         @map("joining_date") @db.Date
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  emergencyContact String?          @map("emergency_contact")

  department  Department?  @relation(fields: [departmentId], references: [id])
  designation Designation? @relation(fields: [designationId], references: [id])

  assignments      EmployeeProjectAssignment[]
  attendances      Attendance[]
  leaveRequests    LeaveRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@index([tenantId, designationId])
  @@index([tenantId, employmentStatus])
  @@index([tenantId, firstName, lastName])
  @@map("employees")
}

model EmployeeProjectAssignment {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  projectId  String @map("project_id") @db.Uuid

  assignmentRole String           @map("assignment_role")
  startDate      DateTime         @map("start_date") @db.Date
  endDate        DateTime?        @map("end_date") @db.Date
  status         AssignmentStatus @default(ASSIGNED)

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, projectId])
  @@map("employee_project_assignments")
}

model Attendance {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  employeeId String  @map("employee_id") @db.Uuid
  projectId  String? @map("project_id") @db.Uuid

  attendanceDate DateTime         @map("attendance_date") @db.Date
  checkIn        DateTime?        @map("check_in")
  checkOut       DateTime?        @map("check_out")
  workedHours    Decimal          @default(0) @map("worked_hours") @db.Decimal(5, 2)
  status         AttendanceStatus
  notes          String?

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, employeeId, attendanceDate])
  @@index([tenantId])
  @@index([tenantId, attendanceDate])
  @@index([tenantId, employeeId])
  @@index([tenantId, projectId])
  @@map("attendance")
}

model LeaveType {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  name        String
  description String?
  status      LeaveTypeStatus @default(ACTIVE)

  leaveRequests LeaveRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("leave_types")
}

model LeaveRequest {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  employeeId  String @map("employee_id") @db.Uuid
  leaveTypeId String @map("leave_type_id") @db.Uuid

  startDate     DateTime           @map("start_date") @db.Date
  endDate       DateTime           @map("end_date") @db.Date
  numberOfDays  Decimal            @map("number_of_days") @db.Decimal(5, 2)
  reason        String?
  status        LeaveRequestStatus @default(PENDING)
  reviewComment String?            @map("review_comment")

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, startDate, endDate])
  @@map("leave_requests")
}