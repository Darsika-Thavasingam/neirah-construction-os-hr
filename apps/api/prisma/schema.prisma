generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["hr"]
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum RecordStatus {
  ACTIVE
  INACTIVE
  @@schema("hr")
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  RESIGNED
  @@schema("hr")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERN
  @@schema("hr")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  @@schema("hr")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HALF_DAY
  HOLIDAY
  @@schema("hr")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  @@schema("hr")
}

enum LeaveTypeStatus {
  ACTIVE
  INACTIVE
  @@schema("hr")
}

enum AssignmentStatus {
  ASSIGNED
  COMPLETED
  CANCELLED
  @@schema("hr")
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
  @@schema("hr")
}

enum SalaryStatus {
  ACTIVE
  INACTIVE
  @@schema("hr")
}

enum AllowanceType {
  ONE_TIME
  RECURRING
  @@schema("hr")
}

enum DeductionType {
  ONE_TIME
  RECURRING
  @@schema("hr")
}

enum AdvanceStatus {
  ACTIVE
  PARTIALLY_RECOVERED
  RECOVERED
  CANCELLED
  @@schema("hr")
}

enum PayrollRunStatus {
  DRAFT
  PROCESSING
  COMPLETED
  CANCELLED
  @@schema("hr")
}

// ─────────────────────────────────────────────
// HR MASTER ENTITIES
// ─────────────────────────────────────────────

model Department {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  name        String
  code        String
  description String?
  status      RecordStatus @default(ACTIVE)

  employees Employee[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, name])
  @@map("departments")
  @@schema("hr")
}

model Designation {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  name        String
  code        String
  description String?
  status      RecordStatus @default(ACTIVE)

  employees Employee[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, name])
  @@map("designations")
  @@schema("hr")
}

model Employee {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  departmentId  String? @map("department_id") @db.Uuid
  designationId String? @map("designation_id") @db.Uuid

  employeeNumber   String           @map("employee_number")
  firstName        String           @map("first_name")
  lastName         String           @map("last_name")
  email            String?
  phone            String?
  nicOrId          String?          @map("nic_or_id")
  dateOfBirth      DateTime?        @map("date_of_birth") @db.Date
  gender           Gender?
  address          String?
  employmentType   EmploymentType   @map("employment_type")
  joiningDate      DateTime         @map("joining_date") @db.Date
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  emergencyContact String?          @map("emergency_contact")

  department  Department?  @relation(fields: [departmentId], references: [id])
  designation Designation? @relation(fields: [designationId], references: [id])

  assignments      EmployeeProjectAssignment[]
  attendances      Attendance[]
  leaveRequests    LeaveRequest[]
  overtimes        Overtime[]
  salaryStructures SalaryStructure[]
  allowances       Allowance[]
  deductions       Deduction[]
  advances         EmployeeAdvance[]
  payrollItems     PayrollItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@index([tenantId, designationId])
  @@index([tenantId, employmentStatus])
  @@index([tenantId, firstName, lastName])
  @@map("employees")
  @@schema("hr")
}

// ─────────────────────────────────────────────
// PROJECT ASSIGNMENT
// ─────────────────────────────────────────────

model EmployeeProjectAssignment {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  projectId  String @map("project_id") @db.Uuid

  assignmentRole String           @map("assignment_role")
  startDate      DateTime         @map("start_date") @db.Date
  endDate        DateTime?        @map("end_date") @db.Date
  status         AssignmentStatus @default(ASSIGNED)

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, projectId])
  @@map("employee_project_assignments")
  @@schema("hr")
}

// ─────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────

model Attendance {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  employeeId String  @map("employee_id") @db.Uuid
  projectId  String? @map("project_id") @db.Uuid

  attendanceDate DateTime         @map("attendance_date") @db.Date
  checkIn        DateTime?        @map("check_in")
  checkOut       DateTime?        @map("check_out")
  workedHours    Decimal          @default(0) @map("worked_hours") @db.Decimal(5, 2)
  status         AttendanceStatus
  notes          String?

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, employeeId, attendanceDate])
  @@index([tenantId])
  @@index([tenantId, attendanceDate])
  @@index([tenantId, employeeId])
  @@index([tenantId, projectId])
  @@map("attendance")
  @@schema("hr")
}

// ─────────────────────────────────────────────
// LEAVE MANAGEMENT
// ─────────────────────────────────────────────

model LeaveType {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  name        String
  description String?
  status      LeaveTypeStatus @default(ACTIVE)

  leaveRequests LeaveRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("leave_types")
  @@schema("hr")
}

model LeaveRequest {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  employeeId  String @map("employee_id") @db.Uuid
  leaveTypeId String @map("leave_type_id") @db.Uuid

  startDate     DateTime           @map("start_date") @db.Date
  endDate       DateTime           @map("end_date") @db.Date
  numberOfDays  Decimal            @map("number_of_days") @db.Decimal(5, 2)
  reason        String?
  status        LeaveRequestStatus @default(PENDING)
  reviewComment String?            @map("review_comment")

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, startDate, endDate])
  @@map("leave_requests")
  @@schema("hr")
}

// ─────────────────────────────────────────────
// OVERTIME
// ─────────────────────────────────────────────

model Overtime {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  employeeId String  @map("employee_id") @db.Uuid
  projectId  String? @map("project_id") @db.Uuid

  date           DateTime       @db.Date
  hours          Decimal        @db.Decimal(5, 2)
  rateMultiplier Decimal        @default(1.5) @map("rate_multiplier") @db.Decimal(4, 2)
  reason         String?
  status         OvertimeStatus @default(PENDING)

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, projectId])
  @@index([tenantId, date])
  @@index([tenantId, status])
  @@map("overtime")
  @@schema("hr")
}

// ─────────────────────────────────────────────
// SALARY CONFIGURATION
// ─────────────────────────────────────────────

model SalaryStructure {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  employeeId    String       @map("employee_id") @db.Uuid
  basicSalary   Decimal      @map("basic_salary") @db.Decimal(12, 2)
  effectiveDate DateTime     @map("effective_date") @db.Date
  salaryStatus  SalaryStatus @default(ACTIVE) @map("salary_status")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("salary_structures")
  @@schema("hr")
}

model Allowance {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  name          String
  amount        Decimal       @db.Decimal(12, 2)
  allowanceType AllowanceType @map("allowance_type")
  effectiveDate DateTime?     @map("effective_date") @db.Date
  payrollMonth  Int?          @map("payroll_month")
  payrollYear   Int?          @map("payroll_year")
  notes         String?

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, payrollMonth, payrollYear])
  @@map("allowances")
  @@schema("hr")  
}

model Deduction {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  name          String
  amount        Decimal       @db.Decimal(12, 2)
  deductionType DeductionType @map("deduction_type")
  effectiveDate DateTime?     @map("effective_date") @db.Date
  notes         String?

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("deductions")
  @@schema("hr")  
}

model EmployeeAdvance {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  advanceAmount    Decimal       @map("advance_amount") @db.Decimal(12, 2)
  date             DateTime      @db.Date
  recoveryAmount   Decimal       @default(0) @map("recovery_amount") @db.Decimal(12, 2)
  remainingBalance Decimal       @map("remaining_balance") @db.Decimal(12, 2)
  status           AdvanceStatus @default(ACTIVE)
  notes            String?

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@map("employee_advances")
  @@schema("hr")  
}

// ─────────────────────────────────────────────
// PAYROLL
// ─────────────────────────────────────────────

model PayrollRun {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  payrollMonth    Int              @map("payroll_month")
  payrollYear     Int              @map("payroll_year")
  status          PayrollRunStatus @default(DRAFT)
  totalGross      Decimal          @default(0) @map("total_gross_salary") @db.Decimal(14, 2)
  totalDeductions Decimal          @default(0) @map("total_deductions") @db.Decimal(14, 2)
  totalNet        Decimal          @default(0) @map("total_net_salary") @db.Decimal(14, 2)
  generatedDate   DateTime?        @map("generated_date") @db.Date
  notes           String?

  items PayrollItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, payrollMonth, payrollYear])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, payrollYear, payrollMonth])
  @@map("payroll_runs")
  @@schema("hr")
}

model PayrollItem {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  payrollRunId String @map("payroll_run_id") @db.Uuid
  employeeId   String @map("employee_id") @db.Uuid

  basicSalary     Decimal @map("basic_salary") @db.Decimal(12, 2)
  totalAllowances Decimal @default(0) @map("total_allowances") @db.Decimal(12, 2)
  overtimeAmount  Decimal @default(0) @map("overtime_amount") @db.Decimal(12, 2)
  grossSalary     Decimal @map("gross_salary") @db.Decimal(12, 2)
  totalDeductions Decimal @default(0) @map("total_deductions") @db.Decimal(12, 2)
  advanceRecovery Decimal @default(0) @map("advance_recovery") @db.Decimal(12, 2)
  netSalary       Decimal @map("net_salary") @db.Decimal(12, 2)

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])
  employee   Employee   @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([payrollRunId, employeeId])
  @@index([tenantId])
  @@index([tenantId, payrollRunId])
  @@index([tenantId, employeeId])
  @@map("payroll_items")
  @@schema("hr")
}